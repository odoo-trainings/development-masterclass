<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="loan_application_rule_user" model="ir.rule">
            <field name="name">Loan Application: user cannot change approved loans</field>
            <field name="model_id" ref="model_loan_application"/>
            <field name="groups" eval="[(4, ref('group_kawiil_financing_user'))]"/>
            <field name="domain_force">[('state', 'not in', ['approved'])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="loan_application_rule_admin" model="ir.rule">
            <field name="name">Loan Application: Admin</field>
            <field name="model_id" ref="model_loan_application"/>
            <field name="groups" eval="[(4, ref('group_kawiil_financing_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
