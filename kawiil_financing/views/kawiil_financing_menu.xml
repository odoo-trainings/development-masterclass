<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ODOP assignment 2.05 - the menu hierarchy.

        Three levels, each one the parent of the next:

            Financing                  the app, on the main dashboard
            └── Motorcycle Financing   a heading in the app's top bar
                └── Loan Applications  the item that opens your action

        The root is written out for you. Add the other two where marked TODO.

        A menuitem with no action is just a container. Only the deepest one
        carries an action, and clicking it is what opens the list.
    -->

    <!-- Worked example. No parent, so this sits at the top of the tree and
         becomes an app in its own right. web_icon points at the icon you
         added in assignment 2.01, in the form "module,path/inside/module". -->
    <menuitem id="menu_kawiil_financing_root"
              name="Financing"
              web_icon="kawiil_financing,static/description/icon.png"
              sequence="10"/>

    <!--
        TODO: id menu_kawiil_financing_motorcycle, name "Motorcycle Financing",
        with parent="menu_kawiil_financing_root". Give it a sequence so you
        control where it sits among its siblings later on.
    -->

    <!--
