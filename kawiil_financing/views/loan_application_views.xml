<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Loan application: action and views.

        Built up across three assignments:
          2.05  the action, opening Odoo's automatic views
          2.07  real list, form and search views, replacing those
          2.08  the tags field and the Compliance Checklist page

        A view is a record like any other. The layout lives in the arch field
        as markup, and Odoo picks the highest priority view of each type for a
        model unless an action names one explicitly.
    -->

    <!-- Assignment 2.05. Worked example. -->
    <record id="action_loan_application" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <!-- Use list, not tree: tree was renamed in Odoo 18. -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first loan application</p>
            <p>Track motorcycle financing from first enquiry through to signature.</p>
        </field>
    </record>

    <!--
        Assignment 2.07. Worked example. Uncomment the record below when you
        reach 2.07 — delete the two comment markers around it, nothing else.

        A Monetary column needs its currency field present to render, but
        nobody wants to see a column of identical currencies.
        column_invisible loads it without showing it.

        Bonus exercise: try widget="badge" on state, or a decoration-danger
        attribute driven by a domain, to make the rows carry meaning at a
        glance.
    -->
