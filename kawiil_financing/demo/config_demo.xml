<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="demo_tag_vip" model="loan.application.tag">
            <field name="name">VIP Customer</field>
            <field name="color">10</field>
        </record>

        <record id="demo_tag_first_time" model="loan.application.tag">
            <field name="name">First-Time Buyer</field>
            <field name="color">4</field>
        </record>

        <record id="demo_tag_high_risk" model="loan.application.tag">
            <field name="name">High Risk</field>
            <field name="color">1</field>
        </record>

        <record id="demo_doc_type_identity" model="loan.application.document.type">
            <field name="name">Proof of Identity (Driver's License / Passport)</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="demo_doc_type_income" model="loan.application.document.type">
            <field name="name">Proof of Income (Recent Payslip)</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="demo_doc_type_insurance" model="loan.application.document.type">
            <field name="name">Motorcycle Insurance Quote</field>
            <field name="is_required" eval="False"/>
        </record>

    </data>
</odoo>
